{
  "uid": "mfd-lab",
  "title": "mfd / Fixture pipeline",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "mfd",
    "fixture"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API metrics available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mfd\"}",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Completed fixture replays",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mfd_runs{status=\"completed\"}",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Queued replays",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mfd_runs{status=\"queued\"}",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Oldest queued run (seconds)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mfd_oldest_queued_seconds",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Runs by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mfd_runs",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Unpublished outbox jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mfd-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mfd_outbox_pending",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
